generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  staffId    String   @unique
  fullName   String
  email      String   @unique
  password   String
  phone      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}